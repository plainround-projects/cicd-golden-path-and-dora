# Copied to .env by `make up`. Local throwaway values for containers that live for one run; nothing here is a secret.
POSTGRES_HOST=localhost
POSTGRES_PORT=55441
POSTGRES_DB=events
POSTGRES_USER=platform
POSTGRES_PASSWORD=local-only-password
LOG_LEVEL=INFO
# The event collector (an HTTP service the pipelines POST to). A local run authenticates with this shared token;
# a generated repository never holds it: in CI the collector is called with a short-lived identity token instead.
COLLECTOR_PORT=55442
COLLECTOR_URL=http://127.0.0.1:55442
COLLECTOR_TOKEN=local-only-collector-token
# The local registry, and the passphrase of the local signing key (empty: a throwaway key for this machine only).
REGISTRY_PORT=55061
REGISTRY=localhost:55061
COSIGN_PASSWORD=
RUNBOOK_BASE=https://wiki.example.com/runbooks
